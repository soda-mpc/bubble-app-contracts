{
  "name": "bubble-contracts",
  "version": "1.0.0",
  "description": "Private ERC20 contracts with MPC capabilities",
  "scripts": {
    "compile": "hardhat compile",
    "compile:sepolia-base": "hardhat compile-for-network --network sepolia-base",
    "compile:kurtosis": "hardhat compile-for-network --network kurtosis",
    "test": "hardhat test",
    "test:oprf-private": "hardhat test test/PrivateERC20OPRF.test.ts --network world-mobile-testnet",
    "deploy:kurtosis": "hardhat run scripts/deploy-private-erc20.ts --network kurtosis",
    "verify:kurtosis": "hardhat verify --network kurtosis",
    "balance": "hardhat run scripts/get-user-balance.ts --network kurtosis",
    "balance:decrypt": "hardhat run scripts/decrypt-user-balance.ts --network kurtosis",
    "balance:proxy": "hardhat run scripts/decrypt-balance-via-proxy.ts --network kurtosis",
    "get-signing-key": "hardhat run scripts/get-signing-key.ts --network kurtosis",
    "deploy:upgradable:base-sepolia": "hardhat run scripts/deploy-upgradable-private-erc20.ts --network sepolia-base",
    "transfer-ownership:base-sepolia": "hardhat run scripts/transfer-ownership-to-safe.ts --network sepolia-base",
    "prepare-upgrade:base-sepolia": "hardhat run scripts/prepare-upgrade.ts --network sepolia-base",
    "verify:environment": "hardhat run scripts/verify-contracts.ts"
  },
  "dependencies": {
    "@sodalabs/bubble-core-contracts": "git+ssh://git@github.com/soda-mpc/bubble-core-contracts.git#initial-version",
    "@grpc/grpc-js": "^1.9.14",
    "@grpc/proto-loader": "^0.7.10",
    "@openzeppelin/contracts": "5.4.0",
    "@openzeppelin/contracts-upgradeable": "5.4.0",
    "@types/node-forge": "^1.3.14",
    "dotenv": "^16.4.5",
    "ethereumjs-util": "^7.1.5",
    "node-fetch": "^3.3.2",
    "node-forge": "^1.3.1",
    "soda-sdk": "0.0.3-test.20251024003447.0",
    "solc": "0.8.26",
    "web3": "^4.0.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.9",
    "@nomicfoundation/hardhat-ethers": "^3.0.9",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.12",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.14",
    "@openzeppelin/hardhat-upgrades": "^3.0.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "chai": "^4.5.0",
    "hardhat": "2.27.1",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "^0.8.16",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.8.3"
  }
}
